# Copy to backend/.env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (LiteLLM). Tier 1 = cheap/fast, Tier 2/3 = capable.
OPTIBOT_MODEL_SIMPLE=claude-haiku-4-5
OPTIBOT_MODEL_COMPLEX=claude-sonnet-5

# Baseline mode uses a single expensive model for every query, by design.
OPTIBOT_MODEL_BASELINE=claude-sonnet-5

# Semantic cache. 0.80 is calibrated for all-MiniLM-L6-v2 — see
# scripts/calibrate_cache.py. Raise it to trade cache hits for safety.
OPTIBOT_CACHE_THRESHOLD=0.80
OPTIBOT_CACHE_TTL_ORDER=300
OPTIBOT_CACHE_TTL_POLICY=1800

# RAG
OPTIBOT_RAG_TOP_K=3
OPTIBOT_RAG_MIN_SCORE=0.15
